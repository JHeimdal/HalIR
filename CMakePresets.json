{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Configure HalIR in Debug mode",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Configure HalIR in Release mode",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/Build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "description": "Build HalIR Debug preset",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "description": "Build HalIR Release preset",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "displayName": "Test Debug",
      "description": "Run CTest in Debug build directory",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "displayName": "Test Release",
      "description": "Run CTest in Release build directory",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}